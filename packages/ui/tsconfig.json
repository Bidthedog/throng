{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  // The renderer (src/renderer, React + .tsx) is built by Vite, not tsc — see
  // vite.config.ts. tsc compiles only the main and preload processes here.
  "include": ["src/main/**/*", "src/preload/**/*"],
  "references": [
    { "path": "../core" },
    { "path": "../ipc-contract" },
    // src/main imports it. TS 7 builds unreferenced projects in parallel, so leaving this out
    // races platform-windows' emit — see project-references-cover-imports.test.ts.
    { "path": "../platform-windows" }
  ]
}
