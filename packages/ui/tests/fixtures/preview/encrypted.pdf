%PDF-1.4
% 074 FR-067 fixture: a document that declares Standard-handler encryption with a user password. PDF.js asks for
% a password (PasswordException); the preview must show "This PDF cannot be displayed: it is protected by a
% password." and offer no prompt. The O/U strings are arbitrary, so no password opens it.
1 0 obj
<< /Type /Catalog /Pages 2 0 R >>
endobj
2 0 obj
<< /Type /Pages /Kids [3 0 R] /Count 1 >>
endobj
3 0 obj
<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] >>
endobj
4 0 obj
<< /Filter /Standard /V 2 /R 3 /Length 128 /P -3904
   /O <2055C756C72E1AD702608E8196ACAD447AD32D17CFF583235F6DD15FED7DAB67>
   /U <7EEE25D02BC98E7B0C53D1C4C2D4D2A300000000000000000000000000000000> >>
endobj
trailer
<< /Root 1 0 R /Encrypt 4 0 R /ID [<0123456789ABCDEF0123456789ABCDEF> <0123456789ABCDEF0123456789ABCDEF>] /Size 5 >>
%%EOF
